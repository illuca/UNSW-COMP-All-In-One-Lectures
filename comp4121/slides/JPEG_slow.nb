                  RowBox[{" ", 
                   RowBox[{"\[Pi]", " ", 
                    RowBox[{"(", 
                    RowBox[{"i", " ", "+", 
                    RowBox[{"1", "/", "2"}]}], ")"}], "k"}]}], "K"], "]"}], 
                " ", 
                RowBox[{"Cos", "[", 
