                    RowBox[{"(", 
                    RowBox[{"j", " ", "+", 
                    RowBox[{"1", "/", "2"}]}], ")"}], "m"}]}], "K"], 
                 "]"}]}]}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", 
             RowBox[{"K", "-", "1"}]}], "}"}], ",", 
           RowBox[{"{", " ", 
            RowBox[{"m", ",", "0", ",", 
             RowBox[{"K", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"DCT", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Round", "[", 
            RowBox[{
             RowBox[{"dct", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j"}], "]"}], "]"}], "/", 
             RowBox[{"Q", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "K"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "K"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"DCTQ", "=", 
