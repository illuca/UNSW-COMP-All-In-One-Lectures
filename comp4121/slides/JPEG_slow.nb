Cell["\<\
Implementation of JPEG with a brute force computation of the DCT, just to \
illustrate how important FFT is for fast calculations.\
\>", "Text",
 CellChangeTimes->{{3.682572235425905*^9, 3.682572341339209*^9}, {
   3.6825727264356403`*^9, 3.682572773829836*^9}, {3.682572963327814*^9, 
   3.682572997244955*^9}, {3.6825734486675587`*^9, 3.6825734520868883`*^9}, {
   3.682573707026421*^9, 3.682573725090567*^9}, {3.6825741794699373`*^9, 
   3.682574185960232*^9}, {3.682587498375218*^9, 3.682587501801383*^9}, {
   3.682589160697543*^9, 3.682589197964211*^9}, {3.68258940164522*^9, 
   3.682589401925603*^9}, {3.68282140325565*^9, 3.682821403255683*^9}, {
   3.6828394511789217`*^9, 3.682839452076589*^9}, 3.71714511282623*^9, 
   3.750202032498851*^9, {3.7819077025862207`*^9, 3.781907771038292*^9}, 
   3.781908498554595*^9},ExpressionUUID->"632690e7-3487-4448-8aa7-\
e15e24566826"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Monitor", "[", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{"block", "=", 
         RowBox[{"imageShift", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"8", 
               RowBox[{"(", 
                RowBox[{"hor", "-", "1"}], ")"}]}], "+", "1"}], ";;", 
             RowBox[{
              RowBox[{"8", 
               RowBox[{"(", 
                RowBox[{"hor", "-", "1"}], ")"}]}], "+", "8"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"8", " ", 
               RowBox[{"(", 
                RowBox[{"ver", "-", "1"}], ")"}]}], "+", "1"}], ";;", 
             RowBox[{
              RowBox[{"8", " ", 
               RowBox[{"(", 
                RowBox[{"ver", "-", "1"}], ")"}]}], "+", "8"}]}]}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"dct", "=", 
