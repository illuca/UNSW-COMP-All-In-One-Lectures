Cell["\<\
Note that now all coordinates are real and that DCT[k+1]= - DCT[2M-k+1] for \
all  k such that 1\[LessEqual] k \[LessEqual] 2M-1:\[LineSeparator]\
\>", "Text",
 CellChangeTimes->{{3.682825383361566*^9, 3.682825395533936*^9}, {
   3.68282544528255*^9, 3.682825497594952*^9}, {3.68282569027523*^9, 
