Cell[BoxData[
 RowBox[{
  RowBox[{"DCOST", "=", 
   RowBox[{"Chop", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"DFT33", "[", 
        RowBox[{"[", 
         RowBox[{"m", "+", "1"}], "]"}], "]"}], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         FractionBox["\[Pi]", 
          RowBox[{"2", "M"}]], "m"}]]}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "0", ",", 
        RowBox[{
         RowBox[{"2", "M"}], "-", "1"}]}], "}"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.682824736337091*^9, 3.682824835888315*^9}, 
   3.682824876681391*^9, {3.682824978247862*^9, 3.682825000907998*^9}, {
