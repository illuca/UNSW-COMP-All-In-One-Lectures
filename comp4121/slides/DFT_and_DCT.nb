Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"ComplexExpand", "[", 
    TagBox[
     RowBox[{"ExpToTrig", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", 
           FractionBox[
            RowBox[{" ", 
             RowBox[{"2", "\[Pi]", " ", "m", " ", "k"}]}], 
            RowBox[{"2", "MM"}]]}]], "+", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", 
           FractionBox[
            RowBox[{" ", 
             RowBox[{"2", "\[Pi]", " ", "m", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", "MM"}], "-", "1", "-", " ", "k"}], ")"}]}]}], 
            RowBox[{"2", "MM"}]]}]]}], ")"}], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         FractionBox["\[Pi]", 
          RowBox[{"2", "MM"}]], " ", "m"}]]}], "]"}],
     CheckAbort[#, 
      Defer[#]]& ], "]"}], ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{
     RowBox[{"MM", "\[Element]", "Integers"}], "&&", 
     RowBox[{"k", "\[Element]", "Integers"}], "&&", 
     RowBox[{"m", "\[Element]", "Integers"}], "&&", 
     RowBox[{"k", "<", "MM"}], "&&", 
     RowBox[{"m", "<", "MM"}]}]}]}], "]"}]], "Input",
