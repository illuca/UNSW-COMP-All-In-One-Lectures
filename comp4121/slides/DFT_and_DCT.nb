Cell[BoxData[
 RowBox[{
  RowBox[{"idct", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Chop", "[", 
      RowBox[{
       FractionBox["4", "K"], 
       RowBox[{"(", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"i", "=", "0"}], 
          RowBox[{"K", "-", "1"}]], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"j", "=", "0"}], 
           RowBox[{"K", "-", "1"}]], 
          RowBox[{
           RowBox[{"a", "[", "i", "]"}], 
           RowBox[{"a", "[", "j", "]"}], 
           RowBox[{"dct", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"i", "+", "1"}], ",", 
              RowBox[{"j", "+", "1"}]}], "]"}], "]"}], 
           RowBox[{"Cos", "[", 
            FractionBox[
             RowBox[{" ", 
              RowBox[{"\[Pi]", " ", 
               RowBox[{"(", 
                RowBox[{"k", " ", "+", 
                 RowBox[{"1", "/", "2"}]}], ")"}], "i"}]}], "K"], "]"}], " ", 
           
           RowBox[{"Cos", "[", 
            FractionBox[
             RowBox[{" ", 
              RowBox[{"\[Pi]", " ", 
               RowBox[{"(", 
                RowBox[{"m", " ", "+", 
                 RowBox[{"1", "/", "2"}]}], ")"}], "j"}]}], "K"], "]"}]}]}]}],
         ")"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", 
       RowBox[{"K", "-", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "0", ",", 
       RowBox[{"K", "-", "1"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.745203395005116*^9, 3.745203397464216*^9}, {
