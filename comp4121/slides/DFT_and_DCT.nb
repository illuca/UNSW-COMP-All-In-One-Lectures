Cell["\<\
Lets consider the following sequence of M samples of a signal \
\>", "Text",
 CellChangeTimes->{{3.682572235425905*^9, 3.682572341339209*^9}, {
   3.6825727264356403`*^9, 3.682572773829836*^9}, {3.682572963327814*^9, 
   3.682572997244955*^9}, {3.6825734486675587`*^9, 3.6825734520868883`*^9}, {
   3.682573707026421*^9, 3.682573725090567*^9}, {3.6825741794699373`*^9, 
   3.682574185960232*^9}, {3.682587498375218*^9, 3.682587501801383*^9}, {
   3.682589160697543*^9, 3.682589197964211*^9}, {3.68258940164522*^9, 
   3.682589401925603*^9}, {3.68282140325565*^9, 3.682821403255683*^9}, {
   3.6828394511789217`*^9, 3.682839452076589*^9}, 3.71714511282623*^9, 
   3.750202032498851*^9},ExpressionUUID->"76631b21-5ff4-4ff9-ab2c-\
a975d6d94e63"],

Cell[BoxData[
 RowBox[{
  RowBox[{"M", "=", "32"}], ";"}]], "Input",
 CellChangeTimes->{{3.750202107834878*^9, 3.750202109099918*^9}, {
  3.750202901192526*^9, 3.7502029021089373`*^9}, {3.750286622913907*^9, 
  3.75028662309795*^9}, {3.750290239834013*^9, 3.750290240390883*^9}, {
  3.750290291673503*^9, 3.7502902918484907`*^9}, {3.750290808807293*^9, 
  3.750290809634657*^9}, {3.75029088033564*^9, 3.750290880521482*^9}, {
  3.750291430623908*^9, 3.7502914309332123`*^9}, {3.7503857954799128`*^9, 
  3.750385795747072*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"1ff0857e-8495-45fb-bcb3-02c6dd003b46"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"signal1", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Cos", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"2", "\[Pi]", "  ", "3", "t"}], "M"], " ", "+", "2"}], "]"}], 
    " ", "+", 
    RowBox[{"2", " ", 
     RowBox[{"Cos", "[", " ", 
      RowBox[{
       FractionBox[
        RowBox[{"2", "\[Pi]", "  ", "7", "t"}], "M"], "-", "1"}], "]"}]}]}]}],
   ";"}]], "Input",
 CellChangeTimes->{{3.717145116152754*^9, 3.717145158535144*^9}, {
  3.750202021238193*^9, 3.750202024918589*^9}, {3.750206135026166*^9, 
  3.75020613856647*^9}, {3.7502064416881933`*^9, 3.7502064468043633`*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"f8f71804-e113-4a56-98b7-d7b3298212a0"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.682813204899682*^9, 3.682813215498808*^9}, {
   3.682813667148594*^9, 3.6828136673480377`*^9}, {3.682813698536625*^9, 
   3.682813720549748*^9}, {3.682814136761362*^9, 3.6828141629933147`*^9}, {
   3.682814311429994*^9, 3.682814311640924*^9}, {3.682814374531847*^9, 
   3.682814375147458*^9}, {3.682814413288911*^9, 3.682814413555347*^9}, {
   3.6828148773548*^9, 3.6828148777789307`*^9}, 3.682822765961721*^9, 
   3.75020200922987*^9},
 CellLabel->"In[59]:=",ExpressionUUID->"7f783919-d50a-492c-8bac-840ae0ceb39f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Samp1", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{"signal1", "[", "t", "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", 
        RowBox[{"M", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.680770157017911*^9, 3.68077044560948*^9}, {
   3.680773071463702*^9, 3.680773079057192*^9}, {3.6825723171892242`*^9, 
