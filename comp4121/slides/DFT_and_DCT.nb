6348238b82d0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IDCTMat", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       SqrtBox[
        RowBox[{"2", "m"}]]], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", 
        FractionBox[
         RowBox[{" ", 
          RowBox[{"\[Pi]", " ", 
           RowBox[{"(", 
            RowBox[{"k", "+", 
             RowBox[{"1", "/", "2"}]}], ")"}], "j"}]}], "m"]}]]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", 
       RowBox[{
        RowBox[{"2", "m"}], "-", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", 
       RowBox[{
        RowBox[{"2", "m"}], "-", "1"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.680775329260494*^9, 3.680775354691122*^9}, {
