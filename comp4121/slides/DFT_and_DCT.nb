Cell["\<\
To verify that we get the same result as before let us compute such \
alternative discrete transform\
\>", "Text",
 CellChangeTimes->{{3.682825657784575*^9, 3.682825668213662*^9}, {
  3.6828267939535227`*^9, 3.682826799634096*^9}, {3.682840311389366*^9, 
  3.682840365097013*^9}},ExpressionUUID->"cd9cc5bb-55eb-4b75-87d3-\
b8f7f9b1cb15"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DCT3", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Chop", "[", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "0"}], 
        RowBox[{
         RowBox[{"2", "M"}], "-", "1"}]], 
       RowBox[{
        RowBox[{"SampFlip", "[", 
         RowBox[{"[", 
          RowBox[{"j", "+", "1"}], "]"}], "]"}], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", 
          FractionBox[
           RowBox[{" ", 
            RowBox[{"\[Pi]", " ", 
             RowBox[{"(", 
              RowBox[{"j", " ", "+", 
               RowBox[{"1", "/", "2"}]}], ")"}], "k"}]}], "M"]}]]}]}], " ", 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", 
       RowBox[{"M", "-", "1"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.680764363331175*^9, 3.680764527007947*^9}, {
   3.68076470482581*^9, 3.680764736269804*^9}, {3.680764937051309*^9, 
   3.680764985900277*^9}, {3.6807650807279997`*^9, 3.680765121607356*^9}, {
