Cell["\<\
The left and the right end of such an extended signal match perfectly! We now \
take the DFT of such a signal; since we have twice as many points now, we \
need a lager matrix of the roots of unity:\
\>", "Text",
 CellChangeTimes->{{3.68282381978076*^9, 3.682823876266966*^9}, {
  3.6828239346555567`*^9, 
  3.682823968697579*^9}},ExpressionUUID->"738d0053-28e4-41fb-aa65-\
06381f73f2c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DFT33", "=", 
   RowBox[{"Chop", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", 
        SqrtBox[
         RowBox[{"2", "M"}]]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], 
         RowBox[{
          RowBox[{"2", "M"}], "-", "1"}]], 
        RowBox[{
         RowBox[{"SampFlip", "[", 
          RowBox[{"[", 
           RowBox[{"j", "+", "1"}], "]"}], "]"}], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", 
           FractionBox[
            RowBox[{"2", "\[Pi]", " ", "j", " ", "k"}], 
            RowBox[{"2", "M"}]]}]]}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", 
        RowBox[{
         RowBox[{"2", "M"}], "-", "1"}]}], "}"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.781898121092201*^9, 3.781898136547768*^9}, 
   3.781898187811154*^9, 3.7818982273691683`*^9},
 CellLabel->
  "In[143]:=",ExpressionUUID->"4ed2ce9f-426e-42ae-8312-c2b4554c1643"],

Cell["\<\
We plot the absolute value of the DFT of such extended sequence:\
\>", "Text",
 CellChangeTimes->{{3.682824076654004*^9, 3.6828240826723137`*^9}, {
  3.682839941690954*^9, 3.68283998194315*^9}, {3.7171307146512203`*^9, 
  3.717130722333108*^9}},ExpressionUUID->"f056582c-371f-49c1-8c36-\
b99c9257c2ac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PlotDFT33", "=", 
  RowBox[{"ListPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"Re", "[", "DFT33", "]"}], "]"}], ",", 
      RowBox[{"Abs", "[", 
       RowBox[{"Im", "[", "DFT33", "]"}], "]"}]}], "}"}], ",", 
    RowBox[{"PlotRange", "\[Rule]", " ", "All"}], ",", 
    RowBox[{"Filling", "->", "Axis"}], ",", 
    RowBox[{"FillingStyle", "\[Rule]", "Automatic"}], ",", 
    RowBox[{"PlotMarkers", "\[Rule]", "Automatic"}], ",", 
    RowBox[{"PlotStyle", "\[Rule]", " ", 
     RowBox[{"{", 
      RowBox[{"Blue", ",", "Red"}], "}"}]}], ",", 
    RowBox[{"ImageSize", "\[Rule]", " ", "600"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.680770676819406*^9, 3.68077067744563*^9}, {
   3.680771098144044*^9, 3.6807711054328136`*^9}, {3.680773260019114*^9, 
