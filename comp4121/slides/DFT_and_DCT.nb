Cell[BoxData[
 RowBox[{"The", " ", "sequence", "  ", "DCT", " ", "is", " ", "called", " ", 
  "the", " ", "Discrete", " ", "Cosine", " ", "Transform", " ", "of", " ", 
  "Type", " ", "II", "  ", "of", " ", "the", " ", "sequence", " ", 
  RowBox[{"Samp2", ".", " "}]}]], "Text",
 CellChangeTimes->{{3.682827228881126*^9, 3.682827278111642*^9}, {
   3.682828044637335*^9, 3.682828107749091*^9}, {3.6828404756200323`*^9, 
   3.6828405302504377`*^9}, 
   3.717141699384637*^9},ExpressionUUID->"60a7c066-ece8-4d1e-a0b9-\
c60b5a50bceb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InvDCT", "=", 
   RowBox[{"Chop", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", "M"}]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], 
         RowBox[{
          RowBox[{"2", "M"}], "-", "1"}]], 
        RowBox[{
         RowBox[{"DCOST", "[", 
          RowBox[{"[", 
           RowBox[{"j", "+", "1"}], "]"}], "]"}], 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[ImaginaryI]", " ", 
           FractionBox[
            RowBox[{" ", 
             RowBox[{"\[Pi]", " ", 
              RowBox[{"(", 
               RowBox[{"k", " ", "+", 
                RowBox[{"1", "/", "2"}]}], ")"}], "j"}]}], "M"]}]]}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", 
        RowBox[{
         RowBox[{"2", "M"}], "-", "1"}]}], "}"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.750969332045268*^9, 3.7509693789353743`*^9}, {
   3.750969409474835*^9, 3.750969427107374*^9}, {3.7509694593296003`*^9, 
   3.750969478407961*^9}, {3.750970257379064*^9, 3.750970291734065*^9}, {
   3.75097501077241*^9, 3.750975014717698*^9}, {3.750975617552463*^9, 
   3.750975624678447*^9}, 3.781900115343845*^9, 3.78190034319687*^9, 
   3.781900473281015*^9},
 CellLabel->
  "In[148]:=",ExpressionUUID->"c861c78b-e26b-4b32-a341-18ef7f67ac25"],

Cell["\<\
The computation of the DCT of type II can further be simplified by using the \
following formula:\
\>", "Text",
 CellChangeTimes->{{3.6828405360431623`*^9, 
  3.682840586858287*^9}},ExpressionUUID->"127d463f-fac2-4976-9c14-\
b71cd0441757"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dct", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{"2", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], 
         RowBox[{"M", "-", "1"}]], 
        RowBox[{
         RowBox[{"Samp3", "[", 
          RowBox[{"[", 
           RowBox[{"j", "+", "1"}], "]"}], "]"}], 
         RowBox[{"Cos", "[", 
          FractionBox[
           RowBox[{" ", 
            RowBox[{"\[Pi]", " ", 
             RowBox[{"(", 
              RowBox[{"j", " ", "+", 
               RowBox[{"1", "/", "2"}]}], ")"}], "k"}]}], "M"], "]"}]}]}]}], 
      " ", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", 
       RowBox[{"M", "-", "1"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.680767731176999*^9, {3.68076778319895*^9, 3.680767794636076*^9}, {
   3.6807679057347813`*^9, 3.680767912492612*^9}, 3.680767947393819*^9, {
   3.680768100406575*^9, 3.680768101785503*^9}, {3.682580742928115*^9, 
   3.682580748330291*^9}, 3.682580859118457*^9, {3.6825809598418016`*^9, 
   3.682580982443131*^9}, 3.68258141163188*^9, {3.682582301467823*^9, 
   3.682582304897644*^9}, {3.682582634258946*^9, 3.682582671976932*^9}, 
   3.682582749242983*^9, {3.6828128528992357`*^9, 3.682812854404114*^9}, {
   3.6828142592079353`*^9, 3.68281426260434*^9}, {3.682822766279029*^9, 
   3.6828227662903347`*^9}, {3.6828273880285482`*^9, 3.682827388452845*^9}, 
   3.7171416993937693`*^9, 3.745703501410932*^9, 3.7502878941393623`*^9, {
   3.781900146313903*^9, 3.781900154638597*^9}, 3.781900351101151*^9, 
   3.78190043244131*^9, {3.781900610161522*^9, 3.78190061108654*^9}},
 CellLabel->
  "In[149]:=",ExpressionUUID->"a42780e5-3f48-4e6b-bdc2-d3819f1dc842"],

Cell["For the Inverse Discrete Cosine Transform  (IDCT) we use", "Text",
 CellChangeTimes->{{3.6828272850862427`*^9, 3.682827319849037*^9}, {
  3.6828406013499804`*^9, 
  3.6828406018209343`*^9}},ExpressionUUID->"feb866a0-c65d-4706-8a49-\
9eda2a9e7c2c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"idct", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Chop", "[", 
      RowBox[{
       FractionBox["1", "M"], 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{"dct", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "2"], "+", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"j", "=", "1"}], 
           RowBox[{"M", "-", "1"}]], 
          RowBox[{
           RowBox[{"dct", "[", 
            RowBox[{"[", 
             RowBox[{"j", "+", "1"}], "]"}], "]"}], 
           RowBox[{"Cos", "[", 
            FractionBox[
             RowBox[{" ", 
              RowBox[{"\[Pi]", " ", 
               RowBox[{"(", 
                RowBox[{"k", " ", "+", 
                 RowBox[{"1", "/", "2"}]}], ")"}], "j"}]}], "M"], "]"}]}]}]}],
         " ", ")"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", 
       RowBox[{"M", "-", "1"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
