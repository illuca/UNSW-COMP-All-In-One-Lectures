Cell[BoxData[
 RowBox[{
  RowBox[{"InverseCompressDFT3", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       SqrtBox["M"]], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "0"}], 
        RowBox[{"M", "-", "1"}]], 
       RowBox[{
        RowBox[{"CompressDFT3", "[", 
         RowBox[{"[", 
          RowBox[{"j", "+", "1"}], "]"}], "]"}], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          FractionBox[
           RowBox[{"2", "\[Pi]", " ", "j", " ", "k"}], "M"]}]]}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", 
       RowBox[{"M", "-", "1"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.750276628874848*^9, 3.750276631608666*^9}, 
   3.78189739153255*^9},
 CellLabel->
  "In[111]:=",ExpressionUUID->"7717c9bc-3a72-44b5-a58e-7fb4e365e198"],

Cell[BoxData[
 RowBox[{
