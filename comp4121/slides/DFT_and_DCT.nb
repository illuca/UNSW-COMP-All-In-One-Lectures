Cell["\<\
To understand that, let us represent the signal in the Fourier basis:\
\>", "Text",
 CellChangeTimes->{{3.6828227181257267`*^9, 3.68282276616381*^9}, {
  3.682822830077435*^9, 3.6828228449492598`*^9}, {3.717141903737547*^9, 
  3.7171419052006817`*^9}, {3.7502764161913548`*^9, 3.750276427890888*^9}, {
  3.750286401192177*^9, 3.7502864015941687`*^9}, {3.781897556960092*^9, 
  3.781897570231163*^9}, {3.781897601854499*^9, 
  3.781897627804133*^9}},ExpressionUUID->"0ce2de20-30a7-4cb7-a67b-\
392ded9d96c0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"F2", "[", "t_", "]"}], ":=", 
    RowBox[{
     FractionBox["1", 
      SqrtBox["M"]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "0"}], 
       RowBox[{"M", "-", "1"}]], 
      RowBox[{
       RowBox[{"DFT2", "[", 
        RowBox[{"[", 
         RowBox[{"j", "+", "1"}], "]"}], "]"}], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", 
         FractionBox[
          RowBox[{"2", "\[Pi]", " ", "j", " ", "t"}], "M"]}]]}]}]}]}], ";"}], 
  "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"F3", "[", "t_", "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     SqrtBox["M"]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], 
      RowBox[{"M", "-", "1"}]], 
     RowBox[{
      RowBox[{"DFT3", "[", 
       RowBox[{"[", 
        RowBox[{"j", "+", "1"}], "]"}], "]"}], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", 
        FractionBox[
         RowBox[{"2", "\[Pi]", " ", "j", " ", "t"}], "M"]}]]}]}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.6828197669738903`*^9, 3.682819851823574*^9}, {
   3.682819936306942*^9, 3.682819941102428*^9}, 3.682820648801528*^9, {
   3.682820688424416*^9, 3.682820695881392*^9}, 3.682821031924652*^9, {
   3.682822766131287*^9, 3.6828227661501617`*^9}, {3.717141845781475*^9, 
   3.7171418531354513`*^9}, {3.7502128455830917`*^9, 3.750212852111092*^9}, {
   3.750212909742189*^9, 3.750212913165249*^9}, {3.781897446041751*^9, 
   3.781897451823807*^9}, {3.781897652526204*^9, 3.781897668602455*^9}},
 CellLabel->
  "In[118]:=",ExpressionUUID->"abdb0f22-249b-481a-b8ef-ff2bbbc0fcb5"],

Cell["\<\
Let us evaluate it over  over TWO complete periods, i.e., instead of from 0 \
to M-1 let us evaluate it from 0 to 2M-1:\
\>", "Text",
 CellChangeTimes->{{3.6828227181257267`*^9, 3.68282276616381*^9}, {
  3.682822830077435*^9, 3.6828228449492598`*^9}, {3.717141903737547*^9, 
  3.7171419052006817`*^9}, {3.7502764161913548`*^9, 3.750276427890888*^9}, {
  3.750286401192177*^9, 3.7502864015941687`*^9}, {3.781897556960092*^9, 
  3.781897570231163*^9}, {3.7818976840893087`*^9, 
  3.7818977503098507`*^9}},ExpressionUUID->"8cea9e33-2cfd-47eb-afd4-\
90dc300e6ce0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Reconstruct2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{"F2", "[", "k", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", 
       RowBox[{
        RowBox[{"2", "M"}], "-", "1"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.682819863745901*^9, 3.682819901603982*^9}, {
   3.6828199878716908`*^9, 3.682819998995246*^9}, 3.6828207296214457`*^9, 
   3.682822766171508*^9, {3.717141918082695*^9, 3.7171419206243877`*^9}, 
   3.7171420048353853`*^9, {3.750212922479084*^9, 3.750212926338895*^9}, {
   3.7818977748635197`*^9, 3.781897775229021*^9}},
 CellLabel->
  "In[120]:=",ExpressionUUID->"ca0d2798-54ab-41e2-8321-2693d0e976f4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Reconstruct3", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"k", ",", 
        RowBox[{"F3", "[", "k", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", 
        RowBox[{
         RowBox[{"2", "M"}], "-", "1"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.68282072352538*^9, 3.6828207316682367`*^9}, 
