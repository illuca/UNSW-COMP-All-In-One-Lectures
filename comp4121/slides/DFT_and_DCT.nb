Cell[TextData[{
 "Complex conjugate transpose of this matrix (normalised by a factor of ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"2", "m"}]], TraditionalForm]],ExpressionUUID->
  "7ad053c8-80d6-4667-a07d-d09a14f68797"],
 ") is:"
}], "Text",
 CellChangeTimes->{{3.682825522761647*^9, 3.682825574207747*^9}, {
  3.717146185384322*^9, 3.7171461941247873`*^9}, {3.717146264393718*^9, 
