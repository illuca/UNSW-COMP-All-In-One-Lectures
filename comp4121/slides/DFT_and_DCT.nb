 RowBox[{
  RowBox[{
   RowBox[{"a", "[", "k_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"k", "==", "0"}], ",", 
     RowBox[{"1", "/", "2"}], ",", "1"}], "]"}]}], ";"}]], "Input",
