Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.682820327801263*^9, 3.682820329659061*^9}},
 CellLabel->"In[64]:=",ExpressionUUID->"bcc846bf-b209-4651-a547-1e023cba9d2f"],

Cell["\<\
The difference is that on the first plot the transition between the two \
periods is smooth, because the last sample and the first sample are not far \
away. However, in the second case there is a big jump from the last sample \
back to the first sample. This is what produces most of these spurious \
frequencies: the values at the end points differ a lot and the IDFT has to \
make a very large jump. \
\>", "Text",
 CellChangeTimes->{{3.682572910383665*^9, 3.682572918944212*^9}, {
   3.682574226854842*^9, 3.682574462374386*^9}, {3.6825892988431664`*^9, 
   3.682589304207575*^9}, {3.682823163484806*^9, 3.682823438953795*^9}, {
   3.7502758214222193`*^9, 3.750275893319338*^9}, 3.7502763549476748`*^9, 
   3.781897878328808*^9},ExpressionUUID->"7d86682d-56b7-40a3-b58f-\
7b15a92fe504"],

Cell["\<\

How can we remedy this? This is what the Discrete Cosine Transform does, and \
more!
Trick: Let us make another copy of the signal samples by flipping the \
original values around: and concatenate it to the original signal:\
\>", "Text",
 CellChangeTimes->{{3.682572910383665*^9, 3.682572918944212*^9}, {
   3.682574226854842*^9, 3.682574462374386*^9}, {3.6825892988431664`*^9, 
   3.682589304207575*^9}, {3.6828187415960693`*^9, 3.6828187438348007`*^9}, {
   3.68282344652558*^9, 3.6828234943262444`*^9}, {3.750275845754169*^9, 
   3.750275856858595*^9}, 
   3.781816858858509*^9},ExpressionUUID->"283864ed-1428-45b1-a867-\
513f62c89d4b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SampFlip", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"Samp3", ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Samp3", "[", 
        RowBox[{"[", 
         RowBox[{"M", "-", "j"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", 
         RowBox[{"M", "-", "1"}]}], "}"}]}], "]"}]}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.682584427933152*^9, 3.682584512433915*^9}, {
   3.682584662487001*^9, 3.682584714190624*^9}, {3.682587676123213*^9, 
   3.6825877064066477`*^9}, {3.6825892384996033`*^9, 3.682589244653365*^9}, {
   3.6825895217845592`*^9, 3.6825895758651657`*^9}, {3.682595857274199*^9, 
   3.682595861152466*^9}, {3.682813322602832*^9, 3.682813326729423*^9}, {
