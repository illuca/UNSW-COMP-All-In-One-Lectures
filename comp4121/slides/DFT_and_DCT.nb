Cell[BoxData[
 RowBox[{
  RowBox[{"DFT3", "=", 
   RowBox[{"Chop", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", 
        SqrtBox["M"]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], 
         RowBox[{"M", "-", "1"}]], 
        RowBox[{
         RowBox[{"Samp3", "[", 
          RowBox[{"[", 
           RowBox[{"j", "+", "1"}], "]"}], "]"}], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", 
           FractionBox[
            RowBox[{"2", "\[Pi]", " ", "j", " ", "k"}], "M"]}]]}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", 
        RowBox[{"M", "-", "1"}]}], "}"}]}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.682577055941128*^9, 3.6825770593074703`*^9}, {
   3.682577824347907*^9, 3.682577826608575*^9}, {3.6828195895175753`*^9, 
