       RowBox[{
        RowBox[{"2", "M"}], "-", "k", "+", "1"}], "]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "1", ",", "M"}], "}"}]}], "]"}], "]"}]], "Input",
