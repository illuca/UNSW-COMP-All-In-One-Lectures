72e0b5d6c770"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DFT2", "=", 
  RowBox[{"Chop", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       SqrtBox["M"]], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "0"}], 
        RowBox[{"M", "-", "1"}]], 
       RowBox[{
        RowBox[{"Samp2", "[", 
         RowBox[{"[", 
          RowBox[{"j", "+", "1"}], "]"}], "]"}], " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", 
          FractionBox[
           RowBox[{"2", "\[Pi]", " ", "j", " ", "k"}], "M"]}]]}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", 
       RowBox[{"M", "-", "1"}]}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.682577055941128*^9, 3.6825770593074703`*^9}, {
   3.682577824347907*^9, 3.682577826608575*^9}, {3.6828195895175753`*^9, 
   3.682819595389732*^9}, {3.682819758201969*^9, 3.6828197589070177`*^9}, 
