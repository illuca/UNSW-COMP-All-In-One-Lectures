   3.6825737275772667`*^9, 3.682573731368075*^9}, 3.682574170506467*^9, {
   3.682575192842922*^9, 3.682575383238166*^9}, {3.682575470359783*^9, 
   3.682575473182729*^9}, {3.6825846099720793`*^9, 3.682584619656663*^9}, {
   3.682587563892086*^9, 3.682587602860754*^9}, {3.6825892120677967`*^9, 
   3.682589223593027*^9}, {3.6828132129237223`*^9, 3.6828132583179007`*^9}, 
   3.682817815887053*^9, {3.682818182618568*^9, 3.682818215499198*^9}, {
   3.6828182683658657`*^9, 3.682818281977647*^9}, {3.6828183129389963`*^9, 
   3.682818317120267*^9}, {3.682818451593874*^9, 3.6828184521667757`*^9}, {
   3.682818992240693*^9, 3.6828189928240128`*^9}, {3.682819526267973*^9, 
