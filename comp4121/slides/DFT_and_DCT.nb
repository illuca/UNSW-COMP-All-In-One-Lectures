fade39c0340c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PlotSamp", "=", 
  RowBox[{"ListPlot", "[", 
   RowBox[{"Samp1", ",", 
    RowBox[{"Joined", "\[Rule]", " ", "True"}], ",", 
    RowBox[{"FillingStyle", "\[Rule]", "Automatic"}], ",", 
    RowBox[{"PlotMarkers", "\[Rule]", "Automatic"}], ",", 
    RowBox[{"PlotStyle", "\[Rule]", " ", 
     RowBox[{"{", "Blue", "}"}]}], ",", 
    RowBox[{"ImageSize", "\[Rule]", " ", "600"}]}], "]"}]}]], "Input",
