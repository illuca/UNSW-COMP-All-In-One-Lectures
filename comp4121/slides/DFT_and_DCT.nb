Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"ConCompDFT3", "[", 
     RowBox[{"[", "n", "]"}], "]"}], "=", 
    RowBox[{"Conjugate", "[", 
     RowBox[{"CompDFT3", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"Floor", "[", 
         RowBox[{"M", "/", "2"}], "]"}], "+", "1", "-", "n"}], "]"}], "]"}], 
