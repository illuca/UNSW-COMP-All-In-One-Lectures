Cell[TextData[{
 "Note that there are 4 peaks because we need two complex exponentials for \
each sinusoids to cancel out imaginary parts:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["c", "^"], 
     RowBox[{"n", "-", "m"}]], " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"\[ImaginaryI]", " ", 
      FractionBox[
       RowBox[{"2", "\[Pi]"}], "n"], "k", " ", 
      RowBox[{"(", 
       RowBox[{"n", "-", "m"}], ")"}]}]]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "2e9c352c-6d6b-4cad-96c8-109e9d309a68"],
 " = Conjugate[ ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["c", "^"], "m"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "84fc4d35-0789-4b3b-828d-a96a11be15c1"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[ImaginaryI]", " ", 
     FractionBox[
      RowBox[{"2", "\[Pi]"}], "n"], "k", " ", "m"}]], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "b133f816-d434-4404-a1d8-f7698fde499e"],
 "];\n\nNow consider instead the following sequence of M samples of  another \
signal, and plot them:"
}], "Text",
