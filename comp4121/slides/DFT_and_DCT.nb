Cell[BoxData[
 RowBox[{
  RowBox[{"InverseCompressDFT2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       SqrtBox["M"]], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "0"}], 
        RowBox[{"M", "-", "1"}]], 
       RowBox[{
        RowBox[{"CompressDFT2", "[", 
         RowBox[{"[", 
          RowBox[{"j", "+", "1"}], "]"}], "]"}], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          FractionBox[
           RowBox[{"2", "\[Pi]", " ", "j", " ", "k"}], "M"]}]]}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", 
       RowBox[{"M", "-", "1"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.7818972585517263`*^9},
 CellLabel->"In[90]:=",ExpressionUUID->"7df08979-1264-4bf6-96de-571af1f14440"],

