Cell["\<\
And now  the inverse transforms of the compressed version of the DCT of the \
signal Samp3\
\>", "Text",
 CellChangeTimes->{{3.682841147460187*^9, 3.6828411760461187`*^9}, {
   3.682841256136071*^9, 3.6828412946104918`*^9}, {3.682841334627926*^9, 
   3.682841343885509*^9}, {3.6828413964915733`*^9, 3.682841416167179*^9}, 
   3.717141699524292*^9, {3.750289514343161*^9, 
   3.750289523409738*^9}},ExpressionUUID->"755574bb-ff8c-4553-adf5-\
d214b92a60da"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InverseCompressDCT3", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Chop", "[", 
      RowBox[{
       FractionBox["1", "M"], 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{"CompressDCT3", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "2"], "+", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"j", "=", "1"}], 
           RowBox[{"M", "-", "1"}]], 
          RowBox[{
           RowBox[{"CompressDCT3", "[", 
            RowBox[{"[", 
             RowBox[{"j", "+", "1"}], "]"}], "]"}], 
           RowBox[{"Cos", "[", 
            FractionBox[
             RowBox[{" ", 
              RowBox[{"\[Pi]", " ", 
               RowBox[{"(", 
                RowBox[{"k", " ", "+", 
                 RowBox[{"1", "/", "2"}]}], ")"}], "j"}]}], "M"], "]"}]}]}]}],
         " ", ")"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", 
       RowBox[{"M", "-", "1"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.682832733163137*^9, 3.682832741564514*^9}, {
   3.682841378248201*^9, 3.6828413837456493`*^9}, {3.682841423820448*^9, 
   3.6828414249096823`*^9}, 3.7171480003829823`*^9, {3.717148051570771*^9, 
   3.7171480599843483`*^9}, 3.717148140481604*^9, {3.7819009098259773`*^9, 
   3.781900910439296*^9}, {3.781901031604517*^9, 3.781901036424921*^9}},
 CellLabel->
  "In[160]:=",ExpressionUUID->"6c3fed06-f0e5-4d09-b8e3-a187cffa6dd2"],

