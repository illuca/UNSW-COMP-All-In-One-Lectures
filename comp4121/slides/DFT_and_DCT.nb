Cell["\<\
Suddenly, most of the \[OpenCurlyDoubleQuote]ghost frequencies\
\[CloseCurlyDoubleQuote] have disappeared, but we have twice as many points. \
However, there has to be a lot of redundancy there because the extra points \
have come from a mirror copy of the original. More over, the DFTs of the \
extended signal is still complex valued, but \[OpenCurlyDoubleQuote]barely so\
\[CloseCurlyDoubleQuote]: note that in\
\>", "Text",
 CellChangeTimes->{{3.682574669792306*^9, 3.6825746998519382`*^9}, {
   3.682824367941373*^9, 3.682824509860441*^9}, {3.682824569913404*^9, 
   3.682824720520488*^9}, {3.68282507676544*^9, 3.682825076765465*^9}, {
   3.682825325865485*^9, 3.6828253258655148`*^9}, {3.682840026719407*^9, 
   3.682840062212041*^9}, {3.682840134381122*^9, 3.682840148387562*^9}, {
   3.750291314641206*^9, 3.750291324923019*^9}, 3.781816941125113*^9, {
   3.7818987119377737`*^9, 
   3.781898767354841*^9}},ExpressionUUID->"fcd5bea4-897c-45ef-be16-\
dd3999b71fe2"],

Cell[BoxData["SampFlip"], "Input",
 CellChangeTimes->{{3.7818987557972603`*^9, 3.7818987584752617`*^9}},
 CellLabel->"In[73]:=",ExpressionUUID->"628a8d35-b1ae-4f7a-9f9d-b0065ecd9814"],

Cell[TextData[{
 "for k=0 to k=2M-1  SampFlip[k]=SampFlip[2M-1-k] and the corresponding \
values of the Fourier kernel are ",
 Cell[BoxData[
  RowBox[{"      ", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", 
      FractionBox[
       RowBox[{" ", 
        RowBox[{"2", "\[Pi]", " ", "m", " ", "k"}]}], 
       RowBox[{"2", "MM"}]]}]], "    ", "and", "     ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", 
      FractionBox[
       RowBox[{" ", 
        RowBox[{"2", "\[Pi]", " ", "m", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "MM"}], "-", "1", "-", " ", "k"}], ")"}]}]}], 
       RowBox[{"2", "MM"}]]}]]}]}]],ExpressionUUID->
  "91d22055-c3e8-406f-9293-0db494d7995f"],
 "; thus, in the sum we get ",
 Cell[BoxData[
  RowBox[{"     ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"SampFlip", "[", "k", "]"}], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        FractionBox[
         RowBox[{" ", 
          RowBox[{"2", "\[Pi]", " ", "m", " ", "k"}]}], 
         RowBox[{"2", "MM"}]]}]]}], "+", 
     RowBox[{
      RowBox[{"SampFlip", "[", 
       RowBox[{
        RowBox[{"2", "M"}], "-", "1", "-", "k"}], "]"}], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        FractionBox[
         RowBox[{" ", 
          RowBox[{"2", "\[Pi]", " ", "m", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "MM"}], "-", "1", "-", " ", "k"}], ")"}]}]}], 
         RowBox[{"2", "MM"}]]}]]}]}], "=", 
    RowBox[{
     RowBox[{"SampFlip", "[", "k", "]"}], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         FractionBox[
          RowBox[{" ", 
           RowBox[{"2", "\[Pi]", " ", "m", " ", "k"}]}], 
          RowBox[{"2", "MM"}]]}]], "+", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         FractionBox[
          RowBox[{" ", 
           RowBox[{"2", "\[Pi]", " ", "m", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "MM"}], "-", "1", "-", " ", "k"}], ")"}]}]}], 
          RowBox[{"2", "MM"}]]}]]}], ")"}]}]}]}]],
  CellChangeTimes->{
   3.750039696592066*^9, {3.750292551244574*^9, 3.7502925626050253`*^9}, 
    3.7508993017001057`*^9, {3.750899515464734*^9, 3.75089953829986*^9}, {
    3.781898892120653*^9, 3.7818988968063297`*^9}},ExpressionUUID->
  "f6168a6f-de78-4340-b311-ce82eb4b85af"],
 "; however, "
}], "Text",
 CellChangeTimes->{{3.682574669792306*^9, 3.6825746998519382`*^9}, {
   3.682824367941373*^9, 3.682824509860441*^9}, {3.682824569913404*^9, 
   3.682824720520488*^9}, {3.68282507676544*^9, 3.682825076765465*^9}, {
