 RowBox[{
  RowBox[{
   RowBox[{"signal2", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Cos", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"2", "\[Pi]", "  ", "1.35", "t"}], "M"], "+", "2"}], "]"}], 
    "+", 
    RowBox[{"2", 
     RowBox[{"Cos", "[", 
      RowBox[{
       FractionBox[
        RowBox[{"2", "\[Pi]", "  ", "4.05", "t"}], "M"], "-", "2"}], 
      "]"}]}]}]}], ";"}]], "Input",
