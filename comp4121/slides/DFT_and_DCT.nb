Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dct", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{
      FractionBox["1", "K"], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], 
        RowBox[{"K", "-", "1"}]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], 
         RowBox[{"K", "-", "1"}]], 
        RowBox[{
         RowBox[{"blockShift", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"i", "+", "1"}], ",", 
            RowBox[{"j", "+", "1"}]}], "]"}], "]"}], 
         RowBox[{"Cos", "[", 
          FractionBox[
           RowBox[{" ", 
            RowBox[{"\[Pi]", " ", 
             RowBox[{"(", 
              RowBox[{"i", " ", "+", 
               RowBox[{"1", "/", "2"}]}], ")"}], "k"}]}], "K"], "]"}], " ", 
         RowBox[{"Cos", "[", 
          FractionBox[
           RowBox[{" ", 
            RowBox[{"\[Pi]", " ", 
             RowBox[{"(", 
              RowBox[{"j", " ", "+", 
               RowBox[{"1", "/", "2"}]}], ")"}], "m"}]}], "K"], "]"}]}]}]}]}],
      "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "0", ",", 
      RowBox[{"K", "-", "1"}]}], "}"}], ",", 
    RowBox[{"{", " ", 
     RowBox[{"m", ",", "0", ",", 
      RowBox[{"K", "-", "1"}]}], "}"}]}], "]"}]}]], "Input",
