Cell["\<\
The DCT in two dimensions is done my doing the DCT in each dimension \
consecutively, i.e., first row wise and then column wise (or the other way \
around)\
\>", "Text",
 CellChangeTimes->{{3.682841561372345*^9, 3.682841635532292*^9}, 
   3.781818684873007*^9, {3.781902747235368*^9, 3.781902824350781*^9}, {
   3.781902854725753*^9, 3.781902898511421*^9}, {3.781902936857835*^9, 
   3.781902969935602*^9}},ExpressionUUID->"3555ac31-260f-479a-900a-\
2edea3985511"],

Cell[BoxData[
 RowBox[{
  RowBox[{"K", "=", "8"}], ";"}]], "Input",
 CellChangeTimes->{{3.7819242042413397`*^9, 3.781924209711733*^9}},
 CellLabel->
  "In[166]:=",ExpressionUUID->"78dfa9aa-1509-4252-82a0-7d1a7c8043de"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox["1", 
    SqrtBox["K"]], 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], 
     RowBox[{"K", "-", "1"}]], 
    RowBox[{
     FractionBox["1", 
      SqrtBox["K"]], 
     RowBox[{"(", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "0"}], 
        RowBox[{"K", "-", "1"}]], 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"i", "+", "1"}], ",", 
           RowBox[{"j", "+", "1"}]}], "]"}], "]"}], " ", 
        RowBox[{"Cos", "[", 
         FractionBox[
          RowBox[{" ", 
           RowBox[{"\[Pi]", " ", 
            RowBox[{"(", 
             RowBox[{"j", " ", "+", 
              RowBox[{"1", "/", "2"}]}], ")"}], "m"}]}], "K"], "]"}]}]}], 
      ")"}], 
     RowBox[{"Cos", "[", 
      FractionBox[
       RowBox[{" ", 
        RowBox[{"\[Pi]", " ", 
         RowBox[{"(", 
          RowBox[{"i", " ", "+", 
           RowBox[{"1", "/", "2"}]}], ")"}], "k"}]}], "K"], "]"}]}]}]}], "=", 
  
  RowBox[{
   FractionBox["1", "K"], 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "0"}], 
     RowBox[{"K", "-", "1"}]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], 
      RowBox[{"K", "-", "1"}]], 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"i", "+", "1"}], ",", 
         RowBox[{"j", "+", "1"}]}], "]"}], "]"}], " ", 
      RowBox[{"Cos", "[", 
       FractionBox[
        RowBox[{" ", 
         RowBox[{"\[Pi]", " ", 
          RowBox[{"(", 
           RowBox[{"j", " ", "+", 
            RowBox[{"1", "/", "2"}]}], ")"}], "m"}]}], "K"], "]"}], 
      RowBox[{"Cos", "[", 
       FractionBox[
        RowBox[{" ", 
         RowBox[{"\[Pi]", " ", 
          RowBox[{"(", 
           RowBox[{"i", " ", "+", 
            RowBox[{"1", "/", "2"}]}], ")"}], "k"}]}], "K"], 
       "]"}]}]}]}]}]}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.7452047577250423`*^9, 3.745204790658783*^9}, {
  3.7452073622323*^9, 3.745207366475893*^9}, {3.745207445941452*^9, 
