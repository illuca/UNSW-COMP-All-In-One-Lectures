Cell["\<\
This is because the coordinates are symmetric : SampFlip[k]=SampFlip[2M-1-k] \
and \[LineSeparator]\
\>", "Text",
 CellChangeTimes->{{3.682825383361566*^9, 3.682825395533936*^9}, {
   3.68282544528255*^9, 3.682825497594952*^9}, {3.68282569027523*^9, 
   3.68282578633955*^9}, {3.682826183063072*^9, 3.6828263097044277`*^9}, {
   3.682826374133684*^9, 3.682826409290072*^9}, 3.718321222550601*^9, 
   3.750969557800419*^9, {3.781817054685844*^9, 3.781817055832572*^9}, {
   3.781899816654481*^9, 
   3.78189986605938*^9}},ExpressionUUID->"a72a0cf2-b421-49bb-a3c3-\
c461e3151968"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Cos", "[", 
     FractionBox[
      RowBox[{
       RowBox[{"(", " ", 
        RowBox[{"k", "+", 
         RowBox[{"1", "/", "2"}]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "MM"}], "-", "m"}], ")"}], " ", "\[Pi]"}], 
      RowBox[{" ", "MM"}]], "]"}], "\[Equal]", 
    RowBox[{"-", 
     RowBox[{"Cos", "[", " ", 
      FractionBox[
       RowBox[{
        RowBox[{"(", " ", 
         RowBox[{"k", "+", 
          RowBox[{"1", "/", "2"}]}], ")"}], " ", "m", " ", "\[Pi]"}], 
       RowBox[{" ", "MM"}]], "]"}]}]}], ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{
     RowBox[{"MM", "\[Element]", "Integers"}], "&&", 
     RowBox[{"k", "\[Element]", "Integers"}], "&&", 
     RowBox[{"m", "\[Element]", "Integers"}], "&&", 
     RowBox[{"k", "<", "MM"}], "&&", 
     RowBox[{"m", "<", "MM"}]}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.750905851130396*^9, 3.7509058541668243`*^9}, {
  3.781902125525257*^9, 3.781902130218026*^9}, {3.7819021702146397`*^9, 
  3.781902179464755*^9}},
 CellLabel->"In[82]:=",ExpressionUUID->"bb07567a-2e8f-4bf2-ae51-487aff862360"],

Cell["\<\
Thus, we need to keep only the first M many values, i.e.  we let \
\>", "Text",
 CellChangeTimes->{{3.682825383361566*^9, 3.682825395533936*^9}, {
  3.68282544528255*^9, 3.682825497594952*^9}, {3.68282569027523*^9, 
  3.68282578633955*^9}, {3.682826183063072*^9, 3.6828263097044277`*^9}, {
  3.682826374133684*^9, 3.682826375078635*^9}, {3.682826423504633*^9, 
  3.682826440149197*^9}, {3.682826473810807*^9, 
  3.682826478658695*^9}},ExpressionUUID->"c91a265e-e860-4e77-a650-\
2f39d25e0d5b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DCT1", "=", 
   RowBox[{"DCOST", "[", 
    RowBox[{"[", 
     RowBox[{"1", ";;", "M"}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.682826453269236*^9, 3.682826467318561*^9}, {
  3.717145993368464*^9, 3.7171460020312977`*^9}},
 CellLabel->"In[83]:=",ExpressionUUID->"f687737f-5968-4c10-aa36-ea6c8afc82dc"],

Cell[TextData[{
 "\nInstead of first taking the DFT of the extended signal and then \
multiplying it with  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", 
    RowBox[{"2", "M"}]], TraditionalForm]],ExpressionUUID->
  "d625f2c0-8a99-4f24-8dce-d5c2534868b7"],
 " taken to the power -",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], "k"}], ","}], TraditionalForm]],ExpressionUUID->
  "6731abfb-a8b7-4bf9-8cdc-25938b0e4d17"],
 " one can go directly by using a slightly different but still an orthonormal \
transform matrix; lets do it first for m=8 so that the matrix fits on paper:"
}], "Text",
 CellChangeTimes->{{3.682826481871634*^9, 3.682826489234502*^9}, {
  3.682826528788308*^9, 3.682826635450457*^9}, {3.682826675613385*^9, 
  3.6828267081148252`*^9}},ExpressionUUID->"15f5da12-3466-47fa-82b2-\
c01ac40efe82"],

Cell[BoxData[
 RowBox[{
  RowBox[{"m", "=", "8"}], ";"}]], "Input",
 CellChangeTimes->{{3.6825807011974792`*^9, 3.682580704957898*^9}},
 CellLabel->
  "In[136]:=",ExpressionUUID->"c2f5dbec-c46b-44c3-afde-fc97acc0bf41"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DCTMat", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       SqrtBox[
        RowBox[{"2", "m"}]]], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        FractionBox[
         RowBox[{" ", 
          RowBox[{"\[Pi]", " ", 
           RowBox[{"(", 
            RowBox[{"j", " ", "+", 
             RowBox[{"1", "/", "2"}]}], ")"}], "k"}]}], "m"]}]]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", 
       RowBox[{
        RowBox[{"2", "m"}], "-", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", 
       RowBox[{
        RowBox[{"2", "m"}], "-", "1"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.680775284620599*^9, 3.680775322298612*^9}, {
