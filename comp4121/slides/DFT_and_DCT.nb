Cell["\<\
Let us take the Discrete Fourier Transform of that sequence and plot its  \
absolute values:\
\>", "Text",
 CellChangeTimes->{{3.682572791155591*^9, 3.682572855921644*^9}, {
   3.6825740692857122`*^9, 3.6825740732456827`*^9}, {3.682584335524746*^9, 
