   3.781902179434885*^9}},ExpressionUUID->"c4ae9f39-3e20-4e06-baa1-\
b702247038c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ComplexExpand", "[", 
  TagBox[
   RowBox[{"ExpToTrig", "[", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", 
       FractionBox[
        RowBox[{" ", 
         RowBox[{"2", "\[Pi]", " ", "m", " ", "k"}]}], 
        RowBox[{"2", "MM"}]]}]], "+", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", 
       FractionBox[
        RowBox[{" ", 
         RowBox[{"2", "\[Pi]", " ", "m", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "MM"}], "-", "1", "-", " ", "k"}], ")"}]}]}], 
        RowBox[{"2", "MM"}]]}]]}], "]"}],
   CheckAbort[#, 
    Defer[#]]& ], "]"}]], "Input",
 CellChangeTimes->{
  3.750039696592066*^9, {3.750292551244574*^9, 3.7502925626050253`*^9}, 
   3.7508993017001057`*^9, {3.750899515464734*^9, 3.75089953829986*^9}, {
   3.781898892120653*^9, 3.7818988968063297`*^9}, {3.7819021701661*^9, 
   3.7819021794368477`*^9}},
 CellLabel->
  "In[132]:=",ExpressionUUID->"e15f079d-bb00-4d8f-9418-47591f9b817d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Cos", "[", 
   FractionBox[
    RowBox[{"k", " ", "m", " ", "\[Pi]"}], "MM"], "]"}], "+", 
  RowBox[{"Cos", "[", 
   FractionBox[
    RowBox[{"m", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "-", "k", "+", 
       RowBox[{"2", " ", "MM"}]}], ")"}], " ", "\[Pi]"}], "MM"], "]"}], "+", 
  RowBox[{"\[ImaginaryI]", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Sin", "[", 
       FractionBox[
        RowBox[{"k", " ", "m", " ", "\[Pi]"}], "MM"], "]"}]}], "-", 
     RowBox[{"Sin", "[", 
      FractionBox[
       RowBox[{"m", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "-", "k", "+", 
          RowBox[{"2", " ", "MM"}]}], ")"}], " ", "\[Pi]"}], "MM"], "]"}]}], 
    ")"}]}]}]], "Output",
 CellChangeTimes->{3.781923215380053*^9},
 CellLabel->
  "Out[132]=",ExpressionUUID->"3fe20809-390f-4cc7-808f-3a241b7bf2bc"]
}, Open  ]],

Cell["Simplifying the imaginary part we get ", "Text",
 CellChangeTimes->{{3.682574669792306*^9, 3.6825746998519382`*^9}, {
   3.682824367941373*^9, 3.682824509860441*^9}, {3.682824569913404*^9, 
   3.682824720520488*^9}, {3.68282507676544*^9, 3.682825076765465*^9}, {
   3.682825325865485*^9, 3.6828253258655148`*^9}, {3.682840026719407*^9, 
   3.682840062212041*^9}, {3.682840134381122*^9, 3.682840148387562*^9}, {
   3.750291314641206*^9, 3.750291324923019*^9}, 3.781816941125113*^9, {
   3.7818987119377737`*^9, 
   3.781899064443927*^9}},ExpressionUUID->"72dfa0d0-2986-4523-975c-\
69cc92363cb2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Sin", "[", 
       FractionBox[
        RowBox[{"m", " ", "k", " ", "\[Pi]"}], "MM"], "]"}]}], "-", 
     RowBox[{"Sin", "[", 
      FractionBox[
       RowBox[{"m", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "-", "k", "+", 
          RowBox[{"2", " ", "MM"}]}], ")"}], " ", "\[Pi]"}], "MM"], "]"}]}], 
    ")"}], "==", 
   RowBox[{
    RowBox[{"-", "2"}], " ", 
    RowBox[{"Cos", "[", 
     FractionBox[
      RowBox[{"m", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "-", 
         RowBox[{"2", " ", "k"}], "+", 
         RowBox[{"2", " ", "MM"}]}], ")"}], " ", "\[Pi]"}], 
      RowBox[{"2", " ", "MM"}]], "]"}], " ", 
    RowBox[{"Sin", "[", " ", 
     RowBox[{"\[Pi]", " ", "m", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        FractionBox["1", 
         RowBox[{"2", " ", "MM"}]]}], ")"}]}], "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.750039721002171*^9, 3.75003972840499*^9}, {
  3.750039980935388*^9, 3.750040047537942*^9}, {3.7502925729010477`*^9, 
  3.750292634358707*^9}, {3.750899866659388*^9, 3.750899896583325*^9}, {
  3.750899935138658*^9, 3.750899942246385*^9}, {3.781902170181485*^9, 
  3.7819021794444017`*^9}},
 CellLabel->
  "In[133]:=",ExpressionUUID->"29d9fb20-f366-4329-9a6a-88e835350973"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.781923245466901*^9},
 CellLabel->
  "Out[133]=",ExpressionUUID->"41b17058-afe7-4e37-a410-1337ae7924fe"]
}, Open  ]],

Cell[TextData[{
 "Note that the imaginary part is \[OpenCurlyDoubleQuote]almost \
\[OpenCurlyDoubleQuote] zero; if instead of ",
 Cell[BoxData[
  RowBox[{"Sin", "[", " ", 
   RowBox[{"\[Pi]", " ", "m", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox["1", 
       RowBox[{"2", " ", "MM"}]]}], ")"}]}], "]"}]],
  CellChangeTimes->{{3.750039721002171*^9, 3.75003972840499*^9}, {
   3.750039980935388*^9, 3.750040047537942*^9}, {3.7502925729010477`*^9, 
   3.750292634358707*^9}, {3.750899866659388*^9, 3.750899896583325*^9}, {
   3.750899935138658*^9, 3.750899942246385*^9}},ExpressionUUID->
  "1bb123fc-1bf5-4fe1-bbfa-3fcbd23f5fbe"],
 " we had ",
 Cell[BoxData[
  RowBox[{"Sin", "[", " ", 
   RowBox[{"\[Pi]", " ", "m"}], "]"}]],
  CellChangeTimes->{{3.750039721002171*^9, 3.75003972840499*^9}, {
   3.750039980935388*^9, 3.750040047537942*^9}, {3.7502925729010477`*^9, 
   3.750292634358707*^9}, {3.750899866659388*^9, 3.750899896583325*^9}, {
   3.750899935138658*^9, 3.750899942246385*^9}},ExpressionUUID->
  "44b86de6-6459-4b19-9ad0-80f93d12537f"],
 " it would be zero."
}], "Text",
 CellChangeTimes->{{3.682574669792306*^9, 3.6825746998519382`*^9}, {
   3.682824367941373*^9, 3.682824509860441*^9}, {3.682824569913404*^9, 
   3.682824720520488*^9}, {3.68282507676544*^9, 3.682825076765465*^9}, {
   3.682825325865485*^9, 3.6828253258655148`*^9}, {3.682840026719407*^9, 
   3.682840062212041*^9}, {3.682840134381122*^9, 3.682840148387562*^9}, {
   3.750291314641206*^9, 3.750291324923019*^9}, 3.781816941125113*^9, {
   3.7818987119377737`*^9, 3.781899025125732*^9}, {3.781899095379633*^9, 
   3.781899162566925*^9}, {3.7819021794459667`*^9, 
   3.7819021794472647`*^9}},ExpressionUUID->"be1956eb-10e5-4de5-962d-\
d2f3476a4d95"],

Cell[TextData[{
 " So we fix this problem by slightly rotating the Fourier kernel by \
multiplying it with ",
 Cell[BoxData[
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", 
    FractionBox["\[Pi]", 
     RowBox[{"2", "MM"}]]}]]],
  CellChangeTimes->{{3.750039022838835*^9, 3.7500390890189743`*^9}, {
   3.750039491662916*^9, 3.750039521147862*^9}, {3.750040083114231*^9, 
   3.7500400930352173`*^9}, {3.750040123053384*^9, 3.750040140111567*^9}, {
   3.750291714866521*^9, 3.750291757356496*^9}, {3.750291932567136*^9, 
   3.750291962357006*^9}, {3.750291999168432*^9, 3.750292022858432*^9}, {
