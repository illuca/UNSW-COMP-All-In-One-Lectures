Cell["\<\
Let us now do some signal compression: let us take k many largest (by the \
absolute value) numbers appearing in FR2 which is the DFT of Samp2 and set \
all others to 0:\
\>", "Text",
 CellChangeTimes->{{3.682828338552629*^9, 3.6828284054706297`*^9}, {
   3.682832014879121*^9, 3.6828320331246843`*^9}, {3.6828409520695457`*^9, 
   3.682840965636467*^9}, {3.682841025205966*^9, 3.68284103105548*^9}, 
   3.717141699454661*^9},ExpressionUUID->"94699977-d5f8-4284-b4b4-\
0c80e9054879"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"KthElement2", "=", 
  RowBox[{
   RowBox[{"Sort", "[", 
    RowBox[{
     RowBox[{"Abs", "[", "DCT3", "]"}], ",", "Greater"}], "]"}], "[", 
   RowBox[{"[", "Kth", "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.6828324716868258`*^9, 3.682832496740316*^9}, 
   3.682832600378107*^9, {3.682832634098173*^9, 3.68283265275629*^9}, {
   3.682841085564808*^9, 3.682841086271378*^9}, 3.717147723304525*^9, {
   3.717147757325265*^9, 3.717147758033257*^9}, {3.750213258470767*^9, 
   3.7502132592858143`*^9}, {3.781900799782962*^9, 3.781900800364764*^9}},
 CellLabel->
  "In[157]:=",ExpressionUUID->"d5a1e401-4099-4f38-b810-fe6cc32a9ff7"],

Cell[BoxData["4.268633247822468`"], "Output",
 CellChangeTimes->{3.781923917420218*^9},
 CellLabel->
  "Out[157]=",ExpressionUUID->"661d7d12-8913-44af-8fcb-86187e0ac41e"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CompressDCT3", "=", "DCT3"}], ";", " ", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"CompressDCT3", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}], "<", "KthElement2"}], ",", 
       RowBox[{
        RowBox[{"CompressDCT3", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "=", "0"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "M"}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.6828325074301767`*^9, 3.682832584850778*^9}, {
  3.6828410960519667`*^9, 3.6828411137103148`*^9}, {3.717147787947809*^9, 
